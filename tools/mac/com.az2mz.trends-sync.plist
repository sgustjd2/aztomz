<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.az2mz.trends-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/bin/bash "$HOME/workspace/side_project/aztomz/tools/mac/job.sh" trends-sync</string>
  </array>
  <!-- 3분마다 DB↔trends.json 비교. 대시보드 편집이 있을 때만 export·validate·refresh·push. 변경 없으면 조용히 끝난다 -->
  <key>StartInterval</key><integer>180</integer>
  <key>ThrottleInterval</key><integer>60</integer>
</dict>
</plist>
