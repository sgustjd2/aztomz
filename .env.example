# 한끗(az2mz) 환경변수 예시 — 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 사이트(frontend/) 자체는 정적이라 환경변수 없이 돌아간다. 아래는 backend/scripts 자동화용이다.

# 펄스 조사·유튜브 요약 (GitHub Actions 에서는 레포 Secrets 로 등록)
GEMINI_API_KEY=
GEMINI_MODEL=

# 블로그 커버 사진 (선택)
PEXELS_API_KEY=

# 검색수요 게이트 keyword-demand.mjs (searchad.naver.com 무료 발급, 선택)
NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER=

# 블로그 발행 (선택)
TISTORY_BLOG=
TISTORY_CATEGORY=

# 로컬 도구 경로 (선택 — 기본값으로 찾지 못할 때만)
DDGS_EXE=
CLAUDE_BIN=
HERMES_HOME=

# Hermes 로컬 관리 콘솔 tools/hermes-admin (127.0.0.1 전용, 선택)
HERMES_ADMIN_TOKEN=
HERMES_ADMIN_PORT=
