            "offsetX": "0",
            "offsetY": "3px"
          }
        ]
      },
      "sm": {
        "$type": "shadow",
        "$value": [
          {
            "blur": "0",
            "color": "rgba(9,34,63,0.06)",
            "spread": "1px",
            "offsetX": "0",
            "offsetY": "0"
          },
          {
            "blur": "2px",
            "color": "rgba(9,34,63,0.04)",
            "spread": "0",
            "offsetX": "0",
            "offsetY": "1px"
          }
        ]
      },
      "xl": {
        "$type": "shadow",
        "$value": [
          {
            "blur": "0",
            "color": "rgba(9,34,63,0.12)",
            "spread": "1px",
            "offsetX": "0",
            "offsetY": "0"
          },
          {
            "blur": "32px",
            "color": "rgba(9,34,63,0.10)",
            "spread": "0",
            "offsetX": "0",
            "offsetY": "16px"
          }
        ]
      },
      "none": {
        "$type": "shadow",
        "$value": "none"
      }
    }
