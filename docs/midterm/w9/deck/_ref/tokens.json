    "shadow": {
      "lg": {
        "$type": "shadow",
        "$value": [
          {
            "blur": "0",
            "color": "rgba(9,34,63,0.10)",
            "spread": "1px",
            "offsetX": "0",
            "offsetY": "0"
          },
          {
            "blur": "16px",
            "color": "rgba(9,34,63,0.08)",
            "spread": "0",
            "offsetX": "0",
            "offsetY": "8px"
          }
        ]
      },
      "md": {
        "$type": "shadow",
        "$value": [
          {
            "blur": "0",
            "color": "rgba(9,34,63,0.08)",
            "spread": "1px",
            "offsetX": "0",
            "offsetY": "0"
          },
          {
            "blur": "6px",
            "color": "rgba(9,34,63,0.06)",
