        "canvas": {
          "$type": "color",
          "$value": "{color.cream}"
        },
        "subtle": {
          "$type": "color",
          "$value": "{color.cream-soft}"
        },
        "inverse": {
          "$type": "color",
          "$value": "{color.navy}"
        },
        "surface": {
          "$type": "color",
          "$value": "{color.cream-strong}"
        }
      },
