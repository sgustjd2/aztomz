        "link": {
          "$type": "color",
          "$value": "{color.blue-strong}"
        },
        "meta": {
          "$type": "color",
          "$value": "{color.gray-muted}"
        },
        "muted": {
          "$type": "color",
          "$value": "{color.gray-muted}"
        },
        "on-dark": {
          "$type": "color",
          "$value": "{color.cream}"
        },
        "primary": {
          "$type": "color",
          "$value": "{color.navy}"
        },
        "secondary": {
          "$type": "color",
          "$value": "{color.gray}"
        },
        "on-dark-muted": {
          "$type": "color",
          "$value": "{color.khaki-light}"
        }
      },
      "state": {
        "info": {
          "$type": "color",
          "$value": "{color.blue-strong}"
        },
        "danger": {
          "$type": "color",
          "$value": "{color.danger}"
        },
        "success": {
          "$type": "color",
          "$value": "{color.khaki}"
        },
        "warning": {
          "$type": "color",
          "$value": "{color.yellow}"
        }
      },
      "accent": {
        "alt": {
          "$type": "color",
          "$value": "{color.khaki}"
        },
        "brand": {
          "$type": "color",
          "$value": "{color.blue}"
        },
        "on-dark": {
          "$type": "color",
          "$value": "{color.yellow}"
        }
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.yellow}"
      }
    }
  },
  "motion": {
    "ease": {
      "ink": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "pop": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      },
      "fold": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.7, 0, 0.84, 0)"
      },
      "page": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.32, 0.72, 0, 1)"
      }
    },
    "duration": {
      "base": {
        "$type": "duration",
        "$value": "280ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "180ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "480ms"
      },
      "blink": {
        "$type": "duration",
        "$value": "500ms"
      }
    }
  },
  "radius": {
    "radius": {
      "lg": {
        "$type": "dimension",
        "$value": "8px"
      },
      "md": {
        "$type": "dimension",
        "$value": "4px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "2px"
      },
