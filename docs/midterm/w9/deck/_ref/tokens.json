      "cream": {
        "$type": "color",
        "$value": "#f3eee2"
      },
      "khaki": {
        "$type": "color",
        "$value": "#5d6c58"
      },
      "danger": {
        "$type": "color",
        "$value": "#a63d33"
      },
      "yellow": {
        "$type": "color",
        "$value": "#ecc95f"
      },
      "navy-soft": {
        "$type": "color",
